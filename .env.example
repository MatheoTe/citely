# --- Database -----------------------------------------------------------------
# docker compose up -d  →  Postgres 17 + pgvector on localhost:5432
DATABASE_URL=postgres://citely:citely@localhost:5432/citely
# No Docker? Embedded Postgres (PGlite + pgvector) persisted to a local folder:
# DATABASE_URL=pglite://./.data/citely
# Neon / PgBouncer: DATABASE_URL is the pooled URL; migrations use the direct one when set.
# DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.region.aws.neon.tech/citely?sslmode=require

# --- Providers (all optional) ------------------------------------------------
# Without keys Citely runs fully offline: hashed n-gram embeddings and an
# extractive answerer. Add keys to switch to the real providers.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# auto | anthropic | offline
CITELY_LLM_PROVIDER=auto
# auto | voyage | local
CITELY_EMBEDDINGS_PROVIDER=auto
# auto | voyage | none
CITELY_RERANKER=auto

CITELY_ANSWER_MODEL=claude-sonnet-5-5
CITELY_FAST_MODEL=claude-haiku-4-5-20251001
# low | medium | high
CITELY_ANSWER_EFFORT=low
CITELY_VOYAGE_EMBED_MODEL=voyage-4
CITELY_VOYAGE_RERANK_MODEL=rerank-3

# --- Retrieval / ingestion ---------------------------------------------------
CITELY_CHUNK_TOKENS=256
CITELY_CHUNK_OVERLAP=48
CITELY_RETRIEVAL_K=6

# --- Limits ------------------------------------------------------------------
CITELY_RATE_LIMIT_PER_MINUTE=20
CITELY_MAX_UPLOAD_MB=10

# --- Public demo -------------------------------------------------------------
# 1 = offline providers even if keys are set, 2 MB uploads, read-only samples,
# nightly reset via /api/demo/reset.
DEMO_MODE=
# 1 = let configured API keys switch on Claude/Voyage in demo mode (costs money)
DEMO_ALLOW_LIVE=
# Shared secret for POST /api/demo/reset (header x-demo-reset-token)
DEMO_RESET_TOKEN=
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
DEMO_MAX_UPLOAD_MB=2
DEMO_MAX_UPLOADS=30
DEMO_UPLOADS_PER_HOUR=10
